<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk_ticket_stage_note.helpdesk_ticket_view_form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="js_class">helpdesk_ticket_stage_note_form</attribute>
            </xpath>
            <xpath expr="//header/field[@name='stage_id']" position="after">
                <field name="stage_note" force_save="1" invisible="1" />
                <field name="stage_note_stage_ids" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field
            name="name"
        >helpdesk_ticket_stage_note.helpdesk_ticket_view_kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="js_class">helpdesk_ticket_stage_note_kanban</attribute>
            </xpath>
            <xpath expr="//kanban/field[@name='stage_id']" position="after">
                <field name="stage_note" force_save="1" />
                <field name="stage_note_stage_ids" />
            </xpath>
        </field>
    </record>
</odoo>
