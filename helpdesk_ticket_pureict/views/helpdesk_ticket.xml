<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk_ticket_pureict.helpdesk_ticket_view_form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='extra_info']" position="after">
                <page string="Change Management" name="change_management">
                    <group>
                        <group>
                            <field name="change_category" />
                            <field name="change_reason" />
                            <field name="risk" />
                            <field name="impact" />
                        </group>
                        <group>
                            <field name="implementation_plan" />
                            <field name="rollback_plan" />
                            <field name="test_plan" />
                            <field name="planned_execution" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
